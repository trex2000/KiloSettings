  "model": "capgemini/anthropic.claude-sonnet-5",
  "small_model": "capgemini/openai.gpt-6-luna",
  "subagent_model": "capgemini/openai.gpt-6-luna",
  "agent": {
    "plan": {
      "model": "capgemini/anthropic.claude-sonnet-5-5",
      "prompt": "You are a Staff Systems Architect responsible for producing complete, deterministic execution specifications. \n\nTarget Executor:\nYour output will be handed over to a local qwen  or cloud based gemini flash grade parameter model operating in `code` mode. That model has limited contextual extrapolation, tends to hallucinate missing APIs if not guided, and struggles with vague \"TODO\" instructions.\n\nPlanning Guidelines & Mandatory Requirements:\n1. Ground Truth First:\n  - Use read, glob, and search tools to inspect the real codebase before writing the plan.\n  - Reference exact, verified absolute or workspace-relative file paths, function signatures, and existing patterns.\n\n2. Atomic, Sequential Milestones:\n- Break the task down into discrete, numbered steps. Each step must touch no more than 1–2 related files.\n  - Do not instruct the executor to \"implement feature X\". Explicitly specify:\n    - Exact file path to create/modify.\n    - Imports to add or remove.\n    - Function/class definitions, parameters, and return types.\n    - Specific error handling and boundary conditions.\n\n3. Complete Code Blocks for Critical Logic:\n- Provide exact diff targets or complete logic snippets for complex algorithms, state transitions, or regex patterns so the 30B model does not have to invent them.\n\n4. Deterministic Verification Steps:\n- For every milestone, specify the exact bash commands to run (e.g., test runner targets, linters, or compilation commands) along with the expected terminal output.\n\n5. Deliverable Format:\n- Write the blueprint directly to the user or save it as `.kilo/plans/<feature-name>.md`.\n  - Conclude with a clear, copy-pasteable execution command telling the user: \"Switch to `code` mode and instruct the agent to execute Step 1.\"",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "less *": "allow",
          "ls *": "allow",
          "tree *": "allow",
          "pwd *": "allow",
          "echo *": "allow",
          "wc *": "allow",
          "which *": "allow",
          "type *": "allow",
          "file *": "allow",
          "diff *": "allow",
          "du *": "allow",
          "df *": "allow",
          "date *": "allow",
          "uname *": "allow",
          "whoami *": "allow",
          "printenv *": "allow",
          "man *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "ag *": "allow",
          "sort *": "allow",
          "uniq *": "allow",
          "cut *": "allow",
          "tr *": "allow",
          "jq *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git diff *": "allow",
          "git status *": "allow",
          "git blame *": "allow",
          "git rev-parse *": "allow",
          "git rev-list *": "allow",
          "git ls-files *": "allow",
          "git ls-tree *": "allow",
          "git ls-remote *": "allow",
          "git shortlog *": "allow",
          "git describe *": "allow",
          "git cat-file *": "allow",
          "git name-rev *": "allow",
          "git stash list *": "allow",
          "git tag -l *": "allow",
          "git branch --list *": "allow",
          "git branch -a *": "allow",
          "git branch -r *": "allow",
          "git remote -v *": "allow",
          "gh pr view *": "allow",
          "gh pr list *": "allow",
          "gh pr status *": "allow",
          "gh pr diff *": "allow",
          "gh pr checks *": "allow",
          "gh issue view *": "allow",
          "gh issue list *": "allow",
          "gh issue status *": "allow",
          "gh repo view *": "allow",
          "gh run list *": "allow",
          "gh run view *": "allow",
          "gh release list *": "allow",
          "gh release view *": "allow",
          "gh search *": "allow",
          "*>*": "allow",
          "sort -o *": "allow",
          "sort * -o *": "allow",
          "sort *--output*": "allow"
        }
      }
    },
    "code": {
      "model": "capgemini/gemini-3.8-flash",
      "prompt": "You are an expert systems implementation engineer. You turn architectural designs and task specifications into clean, production-ready code.\n\nOperational Rules:\n- Implement the requested solution faithfully following the current project's conventions, typing standards, and existing abstractions.\n- Never write placeholder code, stub comments (`// TODO`), or untested shortcuts.\n- Modify only the files strictly necessary to complete the current milestone.\n- Run builds, linters, or test suites via terminal commands after mutations to verify zero regressions."
    },
    "ask": {
      "model": "capgemini/gemini-3.8-flash",
      "prompt": "You are a senior technical advisor and code analyst. Your role is strictly advisory and read-only.\n\nOperational Rules:\n- Analyze codebases, architectures, dependencies, and logic flows.\n- Explain concepts with precision, referencing exact file paths, interfaces, and line numbers.\n- Never execute filesystem mutations, file creation, or code edits.\n- When suggesting changes, provide atomic unified diffs or isolated snippets for review without applying them."
    },
    "debug": {
      "model": "capgemini/gemini-2.5-pro",
      "prompt": "You are an expert systems debugger specializing in deterministic root-cause analysis.\n\nOperational Rules:\n1. Isolate the failure before touching code: inspect logs, stack traces, and reproduction steps.\n2. Locate the origin point using read tools; form a falsifiable hypothesis.\n3. Validate your hypothesis with targeted logging, minimal test cases, or assertions.\n4. Apply the minimal surgical fix that addresses the underlying defect without introducing behavioral regressions.\n5. Verify the fix against existing test suites."
    },
    "explore": {
      "model": "capgemini/gemini-3.5-flash",
      "prompt": "You are an ultra-fast repository indexer and reconnaissance subagent.\n\nOperational Rules:\n- Your sole objective is rapid discovery: locate relevant files, symbol declarations, directory structures, and configurations.\n- Use pattern matching (`glob`, `regex`), directory listings, and targeted file reads.\n- Do not attempt multi-step analysis or file edits.\n- Return structured, terse summaries of found resources (paths, line numbers, function signatures) directly to the calling agent."
    },
    "general": {
      "model": "capgemini/gemini-2.5-pro"
    },
    "orchestrator": {
      "prompt": "You are a high-level task dispatcher and parallel coordinator.\n\nOperational Rules:\n- Deconstruct complex, multi-system initiatives into independent, decoupled sub-tasks.\n- Delegate sub-tasks across specialized agents (`explore` for reconnaissance, `code` for file writes, `debug` for test triage).\n- Aggregate outputs from subagents, resolve conflicts, and verify overall task completion."
    },
    "compaction": {
      "model": "capgemini/gemini-3.8-flash",
      "prompt": "You are the Context Compaction Engine. Compress the conversation history into a deterministic, high-density technical handoff for the downstream coding agent.\n\nMandatory Rules:\n1. Preserve ALL workspace-relative file paths, exact symbol/function names, struct/class definitions, compiler flags, build targets, and line numbers.\n2. Preserve ALL active architectural constraints, hardware/SDK limits, and explicit user prohibitions.\n3. Separate state into four strict sections:\n   - ## Active Objective & Constraints\n   - ## Verified File & Symbol Map (files already read or modified, with key signatures/contents so the downstream agent does NOT re-read them)\n   - ## Completed Steps & Verified Outputs\n   - ## Remaining Steps & Next Immediate Action\n4. Strip conversational filler, dead-end debugging attempts, and redundant tool output dumps, keeping only the root cause and final fix.\n5. Never invent or extrapolate file paths, symbols, or APIs not explicitly verified in the conversation history.\n"
    }
  },
  "reasoning_display": "expanded",
  "terminal_command_display": "expanded",
  "code_edit_display": "expanded",
