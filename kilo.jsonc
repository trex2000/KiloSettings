      "name": "Local Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://chat.cgmures.opensmartliving.ro/ollama/v1"
      },
      "models": {
        "laguna-xs-2.1:latest": {
          "name": "laguna-xs-2.1:latest"
        },
        "qwen3.6:35b-a3b": {
          "name": "qwen3.6:35b-a3b",
          "reasoning": true
        },
        "qwen3.8:27b": {
          "name": "qwen3.8:27b",
          "reasoning": true
        }
      }
